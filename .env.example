# Copy this file to .env and fill in real values before running the server.

# Port the Express server listens on
PORT=3000

# Secret used to sign JWT session tokens - change this to a long random string
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login session stays valid
JWT_EXPIRES_IN=8h

# Path to the SQLite database file (created automatically on first run)
DB_FILE=./hr_system.db
